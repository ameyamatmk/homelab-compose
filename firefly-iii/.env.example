# Portainer UI の環境変数に設定する

# --- Firefly III ---
# 32文字の暗号化キー: openssl rand -base64 32 | head -c 32
APP_KEY=<32-char random string>
# 公開 URL (NPM で立てるホスト名)
APP_URL=https://firefly.homelab.local
# システムメール送信元アドレス
SITE_OWNER=mail@example.com

# --- Database ---
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=<random string>

# --- Cron ---
# 32文字の認証トークン: openssl rand -hex 16
STATIC_CRON_TOKEN=<32-char random string>

# --- LamPyrid (MCP) ---
# Firefly III の Profile → OAuth → Personal Access Tokens で生成
# 初回デプロイ時は空でも OK (lampyrid だけ起動失敗するが他に影響なし)
LAMPYRID_FIREFLY_TOKEN=

# --- mail-ingester ---
# 公開 URL (Google OAuth リダイレクト先と一致させる)
MAIL_INGESTER_PUBLIC_URL=https://mail-ingester.homelab.local
# Google Cloud Console で作成した OAuth クライアント情報
MAIL_INGESTER_GOOGLE_CLIENT_ID=
MAIL_INGESTER_GOOGLE_CLIENT_SECRET=
# リフレッシュトークン暗号化用 Fernet キー
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_INGESTER_OAUTH_ENCRYPTION_KEY=
# Firefly III の Personal Access Token (LAMPYRID とは別トークンを推奨)
MAIL_INGESTER_FIREFLY_TOKEN=
